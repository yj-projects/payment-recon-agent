# Copy values into your local shell; this file is an example, not credentials.
# Required: supply your own subscription, tenant, globally unique registry, repository.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_ACR_NAME=
GITHUB_REPOSITORY=
AZURE_RESOURCE_GROUP=rg-payment-recon-demo
AZURE_LOCATION=eastus
AZURE_CONTAINERAPPS_ENVIRONMENT=cae-payment-recon-demo
AZURE_LOG_ANALYTICS_WORKSPACE=law-payment-recon-demo
AZURE_APP_NAME=ca-payment-recon-demo
AZURE_PULL_IDENTITY_NAME=id-recon-pull
AZURE_CD_IDENTITY_NAME=id-recon-cd
# Set from the CD identity clientId after explicitly running security.
AZURE_CLIENT_ID=
# Keep deployment disabled until explicitly authorized. Never add an API key here.
AZURE_DEPLOYMENT_ENABLED=false
